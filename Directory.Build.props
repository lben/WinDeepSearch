<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Lets the Windows projects compile on macOS/Linux; they still only run on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Builds from a release tag (vX.Y.Z) override this with the tag's version. -->
    <Version>0.2.0</Version>
  </PropertyGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Drives the installed app through UI Automation. Runs on Windows only, after the installer has run. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- A UI element that isn't found fails the test either way. -->
    <Nullable>annotations</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinDeepSearch.Core\WinDeepSearch.Core.csproj" />
    <Compile Include="..\WinDeepSearch.Core.Tests\Fixtures.cs" Link="Fixtures.cs" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <!-- PDFium for running the tests on a Mac; Windows gets it through the Core project. -->
    <PackageReference Include="bblanchon.PDFium.macOS" Version="157.0.8100" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinDeepSearch.Core\WinDeepSearch.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Legacy\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

<UserControl x:Class="WinDeepSearch.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,4,20,16" MaxWidth="880" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Ignored folders" Style="{StaticResource Heading}" />
                    <TextBlock Margin="0,4,0,10" Style="{StaticResource Caption}"
                               Text="Folders with these names are skipped wherever they appear. Type a full path, such as C:\Windows, to skip only that one folder." />
                    <ItemsControl x:Name="IgnoredList" AutomationProperties.AutomationId="IgnoredList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,8,8" Padding="10,0,2,0" Height="30" CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" VerticalAlignment="Center" />
                                        <Button Content="✕" Width="26" Height="26" Padding="0" Margin="4,0,0,0" FontSize="10" Background="Transparent" BorderThickness="0"
                                                Click="RemoveIgnored_Click" Tag="{Binding}" AutomationProperties.Name="{Binding StringFormat='Stop ignoring {0}'}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NothingIgnored" Text="Nothing is ignored, so every folder is searched." Style="{StaticResource Caption}" Visibility="Collapsed" />
                    <WrapPanel Margin="0,6,0,0">
                        <TextBox x:Name="NewIgnored" Width="320" FontFamily="{StaticResource MonoFont}" KeyDown="NewIgnored_KeyDown"
                                 AutomationProperties.AutomationId="NewIgnored" AutomationProperties.Name="Folder name or path to ignore" />
                        <Button Content="Add" Margin="8,0,0,0" MinWidth="64" Style="{StaticResource AccentButtonStyle}" Click="AddIgnored_Click"
                                AutomationProperties.AutomationId="AddIgnored" />
                        <Button Content="Reset to defaults" Margin="8,0,0,0" Click="ResetIgnored_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="IgnoredError" Margin="0,6,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="−" Width="34" Click="FewerLines_Click" AutomationProperties.Name="Fewer lines" />
                        <TextBlock x:Name="ContextLines" Width="40" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                                   AutomationProperties.AutomationId="ContextLines" />
                        <Button Content="+" Width="34" Click="MoreLines_Click" AutomationProperties.Name="More lines" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Hover preview" Style="{StaticResource Heading}" />
                        <TextBlock Margin="0,4,12,0" Style="{StaticResource Caption}" Text="Lines shown above and below each match when you hover a result. Applies to new searches." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Clear remembered text" VerticalAlignment="Center" Click="ClearOcr_Click"
                            AutomationProperties.AutomationId="ClearOcr" />
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Text in images (OCR)" Style="{StaticResource Heading}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}"
                                   Text="Text read from pictures, scanned PDFs and pictures inside Office files is remembered, so searching the same files again skips the slow part." />
                        <TextBlock x:Name="OcrUsage" Margin="0,4,0,0" Style="{StaticResource Caption}" FontSize="12" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="History" Style="{StaticResource Heading}" />
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="Clear history" Click="ClearHistory_Click" AutomationProperties.AutomationId="ClearHistory" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Keep the last" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="HistoryLimit" Width="90" SelectionChanged="HistoryLimit_SelectionChanged" AutomationProperties.Name="Searches to keep">
                                <ComboBoxItem Content="20" />
                                <ComboBoxItem Content="50" />
                                <ComboBoxItem Content="100" />
                                <ComboBoxItem Content="500" />
                            </ComboBox>
                            <TextBlock Text="searches, with their results" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" FontSize="12" Text="Saved on this PC only, in %LOCALAPPDATA%\WinDeepSearch." />
                </StackPanel>
            </Border>

            <TextBlock Margin="0,12,0,0" Text="Changes are saved automatically." Style="{StaticResource Caption}" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

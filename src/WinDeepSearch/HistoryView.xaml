<UserControl x:Class="WinDeepSearch.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinDeepSearch">
    <UserControl.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="8,4,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="12,14,12,8">
                    <DockPanel>
                        <TextBlock x:Name="CountText" DockPanel.Dock="Right" VerticalAlignment="Bottom" Style="{StaticResource Caption}" />
                        <TextBlock Text="History" FontSize="16" FontWeight="SemiBold" />
                    </DockPanel>
                    <Grid Margin="0,10,0,0">
                        <TextBox x:Name="FilterBox" TextChanged="FilterBox_TextChanged" AutomationProperties.AutomationId="HistoryFilter"
                                 AutomationProperties.Name="Filter history" />
                        <TextBlock x:Name="FilterPlaceholder" Text="Filter by search text or folder" IsHitTestVisible="False" Margin="12,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </Grid>
                </StackPanel>
                <Grid>
                    <ListBox x:Name="List" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="List_SelectionChanged"
                             AutomationProperties.AutomationId="HistoryList" AutomationProperties.Name="Saved searches">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:HistoryItem}">
                                <StackPanel>
                                    <DockPanel>
                                        <ItemsControl ItemsSource="{Binding Flags}" DockPanel.Dock="Right" Margin="6,0,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="4,0,0,0" Padding="5,0" CornerRadius="3" BorderThickness="1"
                                                            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                                                        <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding Query}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Scope}" TextTrimming="CharacterEllipsis" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyText" Margin="16,24" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource Caption}" FontSize="13" />
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <TextBlock x:Name="NoSelection" Text="Pick a search on the left to see its saved results." HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource Caption}" FontSize="13" />
                <DockPanel x:Name="Detail" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Margin="20,16,20,14">
                        <TextBlock x:Name="DetailQuery" FontFamily="{StaticResource MonoFont}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailFlags" Margin="0,4,0,0" Style="{StaticResource Caption}" FontSize="13" />
                        <TextBlock x:Name="DetailScope" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="13" />
                        <TextBlock x:Name="DetailMeta" Margin="0,4,0,0" Style="{StaticResource Caption}" />
                        <WrapPanel Margin="0,4,0,0">
                            <TextBlock x:Name="DetailSummary" FontWeight="SemiBold" FontSize="13" Margin="0,0,14,0" />
                            <TextBlock x:Name="DetailSkipped" FontSize="13" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        </WrapPanel>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Open results" Style="{StaticResource AccentButtonStyle}" Click="Open_Click" Margin="0,0,8,0"
                                    AutomationProperties.AutomationId="OpenResults" />
                            <Button Content="Search again" Click="Again_Click" Margin="0,0,8,0" AutomationProperties.AutomationId="SearchAgain" />
                            <Button Content="Remove from history" Click="Remove_Click" AutomationProperties.AutomationId="RemoveHistory" />
                        </WrapPanel>
                    </StackPanel>
                    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    <DockPanel DockPanel.Dock="Top" Margin="20,10,20,4">
                        <TextBlock Text="Saved when the search ran · files may have changed since" DockPanel.Dock="Right" Style="{StaticResource Caption}" />
                        <TextBlock Text="Saved results" FontWeight="SemiBold" FontSize="12" />
                    </DockPanel>
                    <ListBox x:Name="SavedFiles" Margin="8,0,8,8" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="SavedFiles">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:FileRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="22" Margin="0,0,12,0" CornerRadius="4" Background="{Binding BadgeBackground}">
                                        <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="Bold" Foreground="{Binding BadgeForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <DockPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock local:Highlight.Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Folder}" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </DockPanel>
                                    <Border Grid.Column="2" Margin="12,0,0,0" Padding="8,1" VerticalAlignment="Center" CornerRadius="9" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding CountText}" FontSize="12" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

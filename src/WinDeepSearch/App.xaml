<Application x:Class="WinDeepSearch.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinDeepSearch"
             ThemeMode="System">
    <Application.Resources>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="HitLineBrush" Color="#40FFC83D" />

        <!-- The hover preview: the lines around each match and, for text read from a picture, the picture. -->
        <DataTemplate DataType="{x:Type local:Preview}">
            <StackPanel MaxWidth="760" Margin="2">
                <TextBlock TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Title, Mode=OneTime}" FontWeight="SemiBold" />
                    <Run Text="{Binding Folder, Mode=OneTime}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Blocks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="{Binding Location}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <DockPanel Margin="0,4,0,0">
                                    <Border DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Top" BorderThickness="1"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            Visibility="{Binding HasPicture, Converter={StaticResource BoolToVisibility}}">
                                        <Grid MinWidth="120" MinHeight="60">
                                            <TextBlock Text="Loading picture…" FontSize="11" Margin="8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Image Source="{Binding Picture}" MaxWidth="320" MaxHeight="220" Stretch="Uniform" />
                                        </Grid>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Lines}" FontFamily="{StaticResource MonoFont}" FontSize="12.5">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="LineBorder">
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding Number}" Width="56" Margin="0,0,12,0" TextAlignment="Right" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                        <TextBlock local:Highlight.Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsHit}" Value="True">
                                                        <Setter TargetName="LineBorder" Property="Background" Value="{StaticResource HitLineBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding More}" Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>
    </Application.Resources>
</Application>

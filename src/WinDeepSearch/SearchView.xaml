<UserControl x:Class="WinDeepSearch.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinDeepSearch"
             PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SearchToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <DataTemplate DataType="{x:Type local:SectionRow}">
            <TextBlock Text="{Binding Label}" Margin="4,8,0,2" FontWeight="SemiBold" Style="{StaticResource Caption}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:FileRow}">
            <Grid Background="Transparent"
                  ToolTipService.IsEnabled="{Binding HasPreview}" ToolTipService.InitialShowDelay="300"
                  ToolTipService.ShowDuration="3600000" ToolTipService.Placement="Bottom">
                <Grid.ToolTip>
                    <ToolTip MaxWidth="820" Content="{Binding Preview}" />
                </Grid.ToolTip>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Width="28" Height="28" Padding="0" Click="Chevron_Click" VerticalAlignment="Top" Background="Transparent" BorderThickness="0"
                        AutomationProperties.AutomationId="ExpandButton" AutomationProperties.Name="List every match in this file"
                        Visibility="{Binding HasHits, Converter={StaticResource BoolToVisibility}}">
                    <Path Data="M4,6 L8,10 L12,6" Width="16" Height="16" Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform Angle="{Binding ChevronAngle}" />
                        </Path.RenderTransform>
                    </Path>
                </Button>
                <Border Grid.Column="1" Width="40" Height="22" Margin="0,3,12,0" VerticalAlignment="Top" CornerRadius="4" Background="{Binding BadgeBackground}">
                    <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="Bold" Foreground="{Binding BadgeForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <DockPanel>
                        <TextBlock local:Highlight.Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Folder}" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </DockPanel>
                    <DockPanel Visibility="{Binding ShowFirst, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding FirstLocation}" Margin="0,0,10,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock local:Highlight.Text="{Binding FirstLine}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Text="Matched by name · no text inside to search" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding HasNoHits, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <Border Grid.Column="3" Margin="12,0,4,0" Padding="8,1" VerticalAlignment="Center" CornerRadius="9" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <TextBlock Text="{Binding CountText}" FontSize="12" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:HitRow}">
            <DockPanel Margin="82,0,0,0" Background="Transparent"
                       ToolTipService.InitialShowDelay="300" ToolTipService.ShowDuration="3600000" ToolTipService.Placement="Bottom">
                <DockPanel.ToolTip>
                    <ToolTip MaxWidth="820" Content="{Binding Preview}" />
                </DockPanel.ToolTip>
                <TextBlock Text="{Binding Location}" Width="160" Margin="0,0,10,0" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock local:Highlight.Text="{Binding Line}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:MoreRow}">
            <TextBlock Text="{Binding Label}" Margin="82,0,0,4" Cursor="Hand" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:NoteRow}">
            <TextBlock Text="{Binding Label}" Margin="82,0,0,4" TextWrapping="Wrap" Style="{StaticResource Caption}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="20,4,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Where the search runs -->
        <StackPanel>
            <WrapPanel x:Name="FolderScope" Visibility="Collapsed">
                <TextBlock Text="Search in " Style="{StaticResource Caption}" FontSize="13" />
                <TextBlock x:Name="FolderScopePath" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Text=" and all its subfolders" Style="{StaticResource Caption}" FontSize="13" />
            </WrapPanel>
            <WrapPanel x:Name="FileScope" Visibility="Collapsed">
                <TextBlock Text="Started from " Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" />
                <TextBlock x:Name="FileScopePath" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0" />
                <CheckBox x:Name="JustThisFile" Content="Just this selected file" AutomationProperties.AutomationId="JustThisFile"
                          Checked="JustThisFile_Changed" Unchecked="JustThisFile_Changed" />
            </WrapPanel>
            <TextBlock x:Name="ParentScope" Style="{StaticResource Caption}" Visibility="Collapsed" />
            <DockPanel x:Name="AppScope" Visibility="Collapsed">
                <TextBlock Text="Search in" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Caption}" FontSize="13" />
                <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click" AutomationProperties.AutomationId="BrowseButton" />
                <TextBox x:Name="ScopeBox" Text="C:\" MaxWidth="520" HorizontalAlignment="Left" MinWidth="320"
                         AutomationProperties.AutomationId="ScopeBox" AutomationProperties.Name="Folder to search" />
            </DockPanel>
            <Border x:Name="SavedBanner" Visibility="Collapsed" Margin="0,8,0,0" Padding="12,8" CornerRadius="6"
                    Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}">
                <TextBlock x:Name="SavedBannerText" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- Search bar -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QueryBox" FontFamily="{StaticResource MonoFont}" FontSize="14" VerticalContentAlignment="Center" KeyDown="QueryBox_KeyDown"
                     AutomationProperties.AutomationId="QueryBox" AutomationProperties.Name="Search text or regular expression" TextChanged="QueryBox_TextChanged" />
            <TextBlock x:Name="QueryPlaceholder" Text="Text or regular expression, then press Enter" IsHitTestVisible="False" Margin="12,0,0,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <ToggleButton x:Name="RegexToggle" Grid.Column="1" Content=".*" Style="{StaticResource SearchToggle}" ToolTip="Use regular expression (Alt+R)"
                          AutomationProperties.AutomationId="RegexToggle" AutomationProperties.Name="Use regular expression" />
            <ToggleButton x:Name="CaseToggle" Grid.Column="2" Content="Aa" Style="{StaticResource SearchToggle}" ToolTip="Match case (Alt+C)"
                          AutomationProperties.AutomationId="CaseToggle" AutomationProperties.Name="Match case" />
            <ToggleButton x:Name="ImagesToggle" Grid.Column="3" IsChecked="True" Style="{StaticResource SearchToggle}" ToolTip="Search text in images and scanned pages (Alt+I)"
                          AutomationProperties.AutomationId="ImagesToggle" AutomationProperties.Name="Search text in images">
                <Path Data="M1.5,2.5 H14.5 V13.5 H1.5 Z M1.5,11 L5,7.5 L8,10.5 M9.5,5.5 H13 M11.25,5.5 V10" Width="16" Height="16"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.3"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </ToggleButton>
            <Button x:Name="GoButton" Grid.Column="4" Margin="8,0,0,0" MinWidth="96" Height="34" Click="Go_Click" Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.AutomationId="SearchButton" Content="Search" />
        </Grid>

        <TextBlock x:Name="ErrorText" Grid.Row="2" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   Visibility="Collapsed" AutomationProperties.AutomationId="ErrorText" />

        <!-- Results and the files being searched -->
        <Grid Grid.Row="3" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,10">
                        <TextBlock x:Name="ListHeading" Text="Results" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="Hover a result for context · click it to open its folder · use the arrow to list every match" HorizontalAlignment="Right"
                                   TextTrimming="CharacterEllipsis" Margin="16,0,0,0" Style="{StaticResource Caption}" />
                    </DockPanel>
                    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    <Grid>
                        <ListBox x:Name="ResultsList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                 KeyDown="ResultsList_KeyDown" AutomationProperties.AutomationId="ResultsList" AutomationProperties.Name="Results">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="6,3" />
                                    <EventSetter Event="MouseLeftButtonUp" Handler="Row_MouseLeftButtonUp" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <TextBlock x:Name="EmptyText" Margin="32,48" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                                   Style="{StaticResource Caption}" FontSize="13" IsHitTestVisible="False"
                                   Text="Results show up here. Hover a result to see the lines around each match; click it to open its folder in File Explorer." />
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,12">
                        <DockPanel>
                            <TextBlock x:Name="PanelThreads" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Bottom" />
                            <TextBlock x:Name="PanelTitle" Text="Files being searched" FontWeight="SemiBold" />
                        </DockPanel>
                        <ProgressBar x:Name="OverallProgress" Margin="0,10,0,0" Maximum="1" Visibility="Collapsed" AutomationProperties.AutomationId="OverallProgress" />
                        <TextBlock x:Name="PanelCounts" Margin="0,6,0,0" Style="{StaticResource Caption}" />
                    </StackPanel>
                    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel x:Name="SkippedPanel" DockPanel.Dock="Bottom" Margin="16,10,16,12" Visibility="Collapsed">
                        <TextBlock x:Name="SkippedTitle" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <ItemsControl x:Name="SkippedList" AutomationProperties.AutomationId="SkippedList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" Style="{StaticResource Caption}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,6">
                            <ItemsControl x:Name="ActiveList" AutomationProperties.AutomationId="ActiveList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:ActiveRow}">
                                        <Grid Margin="8,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Size}" DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource Caption}" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Folder}" TextTrimming="CharacterEllipsis" Style="{StaticResource Caption}" />
                                                <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Margin="0,6,0,0" />
                                                <TextBlock Text="{Binding Stats}" Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Skip" Margin="10,0,0,0" VerticalAlignment="Center" Click="Skip_Click"
                                                    ToolTip="Stop searching this file and move on" AutomationProperties.Name="{Binding SkipName}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="PanelNote" Margin="8,8" TextWrapping="Wrap" Style="{StaticResource Caption}" FontSize="13"
                                       Text="Press Enter or Search to start. Files that take more than half a second show up here with a progress bar and a Skip button." />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status bar -->
        <WrapPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBlock x:Name="StatusText" Text="Ready · press Enter to search" Margin="0,0,18,0" Style="{StaticResource Caption}" AutomationProperties.AutomationId="StatusText" />
            <TextBlock x:Name="StatusCounts" Margin="0,0,18,0" Style="{StaticResource Caption}" AutomationProperties.AutomationId="StatusCounts" />
            <TextBlock x:Name="StatusSkipped" Margin="0,0,18,0" Style="{StaticResource Caption}" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
        </WrapPanel>
    </Grid>
</UserControl>
